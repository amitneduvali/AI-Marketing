# CortexPulse AI Backend Configuration

PROJECT_NAME="CortexPulse AI"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Server
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase / PostgreSQL Connection URL
# Replace with your Supabase PostgreSQL pooler/direct connection string
# Example: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cortex_pulse

# Supabase API Credentials (for future client-side and webhook integrations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Security (for future authentication)
SECRET_KEY=cortex_pulse_development_secret_key_change_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
